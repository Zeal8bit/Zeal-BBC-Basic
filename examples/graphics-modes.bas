10 REM Native Zeal modes. BBC MODE 7 remains reserved for teletext.
20 FOR I%=1 TO 8
30 READ M%
40 MODE M%
50 PRINT "Zeal mode ";M%
60 IF M%<8 OR M%>9 THEN GOTO 100
70 GCOL 0,224:MOVE 0,0:DRAW 1279,1023:MOVE 0,1023:DRAW 1279,0
80 MOVE 120,120:PLOT 101,360,360
90 PRINT "POINT = ";POINT(0,0)
100 PRINT "Press a key"
110 A$=GET$
120 NEXT
130 MODE 3
140 END
150 DATA 3,6,8,9,10,11,12,13
