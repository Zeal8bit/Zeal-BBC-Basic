10 REM XOR draws the same box twice to erase it without a trail
20 MODE 9
30 VDU 19,7,7,0,0,0
40 COLOUR 7:PRINT TAB(5,0);"THE INCREDIBLE XOR BOX"
50 PRINT TAB(2,18);"Watch it bounce!";
60 X%=100:Y%=200:DX%=24:DY%=20
70 FOR F%=1 TO 120
80 GCOL 3,7:MOVE X%,Y%:PLOT 101,X%+120,Y%+120
90 FOR D%=1 TO 80:NEXT
100 MOVE X%,Y%:PLOT 101,X%+120,Y%+120
110 IF X%+DX%<0 OR X%+DX%>1150 THEN DX%=-DX%
120 IF Y%+DY%<160 OR Y%+DY%>780 THEN DY%=-DY%
130 X%=X%+DX%:Y%=Y%+DY%
140 NEXT
150 GCOL 0,7:MOVE X%,Y%:PLOT 101,X%+120,Y%+120
160 COLOUR 7:PRINT TAB(2,18);"Any key: back to text";
170 A$=GET$
180 MODE 3
190 END
